# Copiar a vps/.env en el VPS (NO commitear el real).
POSTGRES_DB=streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=cambiar-esto-db

# Imagenes (CI las publica en GHCR; en prod se puede pinnear por sha).
API_IMAGE=ghcr.io/hectororviz/rtsp-streaming-api:latest
WEB_IMAGE=ghcr.io/hectororviz/rtsp-streaming-web:latest

# Backoffice: token compartido del admin (elegir uno largo y unico).
ADMIN_TOKEN=cambiar-esto-admin

# Partido demo inicial (solo si la DB esta vacia).
SEED_PIN=1234
SEED_RIVAL=Rival a definir

# Mercado Pago (fase siguiente).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
